# ==============================================================================
# E-Kalavya System Environment Variables (Production & Development Specification)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_NAME=ekalavya-backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Add the website's own origin if it ever calls the backend directly from the browser
# instead of through its own server-side proxy (e.g. http://localhost:3002 in dev,
# or the deployed website's real domain in production).

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL via Prisma ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://ekalavya_user:ekalavya_pass@localhost:5432/ekalavya_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Cache & Queue (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JWT Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_minimum_32_character_random_string
JWT_EXPIRES_IN=7d
# Optional API Key to protect developer console routes in production
DEV_CONSOLE_API_KEY=

# ------------------------------------------------------------------------------
# 5. Local LLM & AI Orchestration (Ollama & OpenAI)
# ------------------------------------------------------------------------------
# Options: 'ollama' | 'openai' | 'openrouter' | 'deterministic'
LLM_PROVIDER=ollama
USE_REAL_LLM=true

# Ollama Local Configuration (qwen3.8:27b, gemma4:26b, etc.) — needs a host with enough RAM/GPU;
# not viable on a small instance like t3.medium, use openrouter there instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_REQUEST_TIMEOUT_MS=30000

# Optional OpenAI Cloud Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenRouter Cloud Provider. Leave OPENROUTER_MODEL unset to let the per-agent split
# below apply: customer-facing WhatsApp personas (AdmissionsAI, DemoCoordinatorAI,
# ParentEngagementAI) use OPENROUTER_MODEL_CUSTOMER_FACING; backend/orchestration agents
# (ChiefOfStaffAI, AcademicMonitoringAI, ReportingAnalyticsAI) use OPENROUTER_MODEL_BACKEND.
# Setting OPENROUTER_MODEL always overrides both.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_MODEL_CUSTOMER_FACING=qwen/qwen3.8-flash
OPENROUTER_MODEL_BACKEND=z-ai/glm-5.3-flash

# Hermes Agent Orchestrator
HERMES_API_URL=http://localhost:8080
HERMES_API_KEY=

# ------------------------------------------------------------------------------
# 6. Messaging Gateway (Evolution GO / WhatsApp)
# ------------------------------------------------------------------------------
# Gateway base URL. Local dev (docker-compose.override.yml publishes it): http://localhost:8081
# Inside docker compose the backend service overrides this to http://evolution-go:8080.
EVOLUTION_GO_URL=http://localhost:8081
# Instance token. Sent as the `apikey` header on every send AND expected on inbound webhooks
# (Evolution GO includes it as `instanceToken` in each event body). Choose a long random value
# (openssl rand -hex 24) and create the instance with exactly this token:
#   curl -X POST $EVOLUTION_GO_URL/instance/create -H "apikey: $EVOLUTION_GO_GLOBAL_API_KEY" \
#        -H 'Content-Type: application/json' -d '{"name":"ekalavya-main","token":"<this value>"}'
# then pair the phone via the Manager UI ($EVOLUTION_GO_URL/manager) QR code.
# The webhook endpoint is POST /webhooks/evolution-go (set globally via WEBHOOK_URL in docker-compose.yml).
# If unset, the webhook answers 503 and sends fail loudly.
EVOLUTION_GO_API_KEY=
# Instance name (informational; shown by GET /api/v1/messages/status)
EVOLUTION_GO_INSTANCE=ekalavya-main
# Gateway admin key (used by docker-compose.yml for the evolution-go service and to create the instance).
# NOT read by the backend.
EVOLUTION_GO_GLOBAL_API_KEY=
# Optional compose-level settings: EVOLUTION_GO_IMAGE (pin the image tag), EVOLUTION_POSTGRES_PASSWORD, POSTGRES_PASSWORD

# Meta (Facebook/Instagram) Lead Ads webhook: POST/GET /webhooks/meta-leads
# App secret used to verify X-Hub-Signature-256 (raw-body HMAC). If unset the webhook answers 503.
META_APP_SECRET=
# Handshake token for the GET verification Meta performs when you subscribe. If unset the handshake answers 503.
META_VERIFY_TOKEN=
# Page access token (leads_retrieval permission). Meta's webhook only carries the leadgen id; the
# lead's answers (full_name, phone_number, email, ...) are fetched from the Graph API with this token.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Founder Emergency Escalation WhatsApp Number (Country code + phone without +)
FOUNDER_WHATSAPP_NUMBER=919876543210

# ------------------------------------------------------------------------------
# 7. Google Sheets Synchronization (Optional)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# ------------------------------------------------------------------------------
# 8. Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 9. Voice call agent (Python service in backend/call_agent)
# ------------------------------------------------------------------------------
# Shared secret the call agent sends as 'X-Agent-Key' to /api/v1/agent-api/*.
# If unset those routes answer 503 (never open). Generate with: openssl rand -hex 32
EKALAVYA_AGENT_KEY=
# Where the Node API finds the call agent (GET /health) for Dev Console > Voice.
CALL_AGENT_URL=http://localhost:8085
# Optional: if set, sent as a Bearer token to the call agent's /health so the status includes details.
CALL_AGENT_API_KEY=

# ------------------------------------------------------------------------------
# Email (Resend) - every parent/teacher message also goes out by email
# ------------------------------------------------------------------------------
# Create a key at https://resend.com/api-keys (a "sending access" key is enough). Leave empty to disable email.
RESEND_API_KEY=
# Verified sending domain in Resend. Senders: hello@ (class links, reminders), security@ (logins, passwords),
# reports@ (weekly reports, attendance), no-reply@ (automated briefings and alerts)
EMAIL_DOMAIN=e-kalavya.com
# Optional full overrides, e.g. EMAIL_FROM_GENERAL="E-Kalavya <hello@e-kalavya.com>"
# EMAIL_FROM_GENERAL=
# EMAIL_FROM_SECURITY=
# EMAIL_FROM_REPORTS=
# EMAIL_FROM_SYSTEM=
# Set to false to switch email off without removing the key
# EMAIL_ENABLED=true
# Public URL of the dashboard, used for "Sign in" buttons in emails
APP_URL=http://localhost:3000

# Public URL of the parent/student portal website, included in the WhatsApp admission
# welcome message as a passwordless-login invite. Set once the public website is deployed.
PORTAL_URL=

# ------------------------------------------------------------------------------
# Login: email OTP (second factor after the password)
# ------------------------------------------------------------------------------
# Comma-separated list of login emails that get a FIXED code instead of a real emailed one
# (useful for local dev / CI so login never depends on a mailbox). Leave empty in production.
DEV_OTP_BYPASS_EMAILS=
# The fixed code those accounts must enter. Default: 654321
DEV_OTP_CODE=654321
# Reply-To address for hello@ / reports@ / security@ emails. Default: ekalavyavirtualclasses@gmail.com
EMAIL_REPLY_TO=

# Copy to .env (never commit it). Real environment variables win over this file.

# --- Auth (required) ---
CALL_AGENT_API_KEY=            # clients send "Authorization: Bearer <key>" or ?token=<key>
EKALAVYA_API_URL=http://localhost:3001/api/v1
EKALAVYA_AGENT_KEY=            # must equal EKALAVYA_AGENT_KEY in backend/.env

# --- LLM: ollama | openai | openrouter ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=                  # required for ollama, e.g. a tool-calling capable model you have pulled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- TTS: google | mms | none (none = text-only calls) ---
TTS_PROVIDER=none
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_TA=ta-IN-Wavenet-A
GOOGLE_TTS_VOICE_EN=en-IN-Wavenet-A

# --- STT ---
WHISPER_MODEL_PATH=../model/whisper-tamil-small
STT_LANGUAGE=auto              # auto | ta | en
STT_DEVICE=cpu                 # cpu | mps | cuda

# --- Limits / VAD ---
MAX_CALL_SECONDS=900
MAX_FRAME_BYTES=64000
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_MS=600

# --- Browser clients (comma-separated origins; empty = no CORS) ---
CALL_AGENT_CORS_ORIGINS=

# --- Twilio Media Streams (optional) ---
TWILIO_STREAM_ENABLED=false
TWILIO_AUTH_TOKEN=
TWILIO_STREAM_URL=             # public wss://host/ws/twilio URL used for X-Twilio-Signature validation

# --- Spool for call logs when Node is down ---
# CALL_AGENT_SPOOL_DIR=
